# Main database used by the Mondel backend.
MONDEL_DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@127.0.0.1:3306/mondel

# Dedicated database used only by automated tests.
MONDEL_TEST_DATABASE_URL=mysql+pymysql://TEST_USERNAME:TEST_PASSWORD@127.0.0.1:3306/mondel_test

# MLflow Tracking Server queried by the Mondel backend.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
